# Playwright e2e
e2e/fixtures/
test-results/
playwright-report/
# RU MoD ingest local artifacts
scripts/ru_mod/output/
# Wartears ingest local artifacts
scripts/wartears/output/
# Mediazona ingest local artifacts
scripts/mediazona/output/
# UA losses ingest local artifacts
scripts/ua_losses/output/
.pytest_cache/

# SBU Alfa: the article HTMLs here ARE the parser's test fixtures — every
# golden value in test_parse.py is keyed on one — so they're tracked despite
# being ~50 KB each and nominally re-fetchable. "Re-fetchable" only holds while
# SBU keeps the URL up and unedited, and a fixture missing from a checkout
# silently skips its month's coverage. Anything else that lands in this
# directory (scratch downloads, a local DB) stays out.
scripts/sbu_alfa/fixtures/*
!scripts/sbu_alfa/fixtures/*.html

.claude/worktrees