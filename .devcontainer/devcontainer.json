{
  "name": "SBS Stats",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-bookworm",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:latest": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  // ~/.claude.json is deliberately NOT mounted. A single-file bind mount is
  // pinned to an inode, not a path, and Claude Code saves that file by writing
  // a temp and renaming it over the old one — a new inode every save. The
  // mount then points at a deleted file: the two sides drift apart silently
  // (one run had the host at 164 startups and the container at 162), and the
  // next `docker start` dies with "error mounting … no such file or
  // directory", which only a rebuild clears. Nothing is lost by leaving it
  // out: credentials live in ~/.claude/.credentials.json and transcripts,
  // plugins and settings in ~/.claude, all inside the DIRECTORY mount below,
  // which has no such problem. The container keeps its own .claude.json.
  // Started empty, though, that file sends every rebuild through onboarding
  // again (theme picker first), so it is seeded once from a copy instead:
  // initializeCommand runs on the host before each create/start and snapshots
  // the host's file into the mounted ~/.claude, and postCreateCommand copies
  // that snapshot into place. Only on create — a running container's file is
  // its own from then on, so there is nothing to keep in sync.
  // `.gitconfig` is exposed the same way (git config rewrites atomically too);
  // it is read-only and rarely edited, so it is left as is.
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/node/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,readonly",
    // Claude Code's temp root — scratchpads and background-task output — in a
    // named volume, so a rebuild doesn't take it with the container. It is not
    // a host bind: this is scratch, and it stays out of the host's /tmp. A
    // fresh volume is root-owned, hence the chown that opens postCreateCommand.
    "source=claude-tmp-sbs-stats,target=/tmp/claude-1000,type=volume"
  ],
  // The host's ~/.claude is bind-mounted onto /home/node/.claude, but Claude
  // Code's plugin paths are absolute and all descend from one root: the
  // installLocation in plugins/known_marketplaces.json, which the host
  // registered as /home/martin/... Nothing in here resolves that, so /plugin
  // reports "cache-miss" and no plugins load — installing from inside the
  // container doesn't help, it inherits the same host path. The alias fixes it.
  "initializeCommand": "if [ -f \"$HOME/.claude.json\" ]; then cp \"$HOME/.claude.json\" \"$HOME/.claude/.claude.json.host-seed\"; fi",
  "postCreateCommand": "sudo chown node:node /tmp/claude-1000 && if [ -f ~/.claude/.claude.json.host-seed ]; then install -m 600 ~/.claude/.claude.json.host-seed ~/.claude.json; fi && sudo ln -sfn /home/node /home/martin && sudo apt-get update && sudo apt-get install -y sqlite3 && npm install && pip install --user -r scripts/requirements.txt && sudo npx --yes playwright install-deps chromium && npx --yes playwright install chromium",
  "appPort": ["6173:5173"],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "anthropic.claude-code"
      ]
    }
  },
  "containerEnv": {
    "NPM_CONFIG_FUND": "false",
    "DISABLE_AUTOUPDATER": "1"
  },
  "remoteUser": "node"
}
